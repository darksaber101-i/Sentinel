# ── Tooling secrets (project root) ────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
#   Windows :  Copy-Item .env.example .env
#   mac/Linux: cp .env.example .env
#
# `.mcp.json` references these as ${VAR}. Claude Code expands ${VAR} from the
# system environment and does NOT read .env itself, so start Claude Code via
# the launcher, which loads this file first:
#
#   Windows :  .\start.ps1
#   mac/Linux: ./start.sh

# Google Stitch MCP server — https://stitch.googleapis.com
STITCH_API_KEY=your_stitch_api_key_here
