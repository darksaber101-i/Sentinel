.claude/scheduled_tasks.lock

# ── Large data ────────────────────────────────────────────────────────────────
# PaySim is 471MB — far over GitHub's 100MB per-file limit. Document the
# download URL in the README instead of committing it.
PS_20174392719_*.csv
*.csv.gz

# Generated dataset (recreate with: PYTHONPATH=. python -m ml.data_generator)
ai-risk-manager/data/synthetic_orders.csv

